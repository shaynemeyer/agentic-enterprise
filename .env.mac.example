LLM_PROVIDER=ollama
LLM_BASE_URL=http://host.containers.internal:11434/v1
LLM_MODEL=mistral-nemo:12b
DATABASE_URL=postgresql+asyncpg://agent:agent@db:5432/agent_db
# For a bare local run (no compose network), point at localhost instead.
# The db container publishes on host port 5433 (not 5432) to avoid colliding
# with a native Postgres.
# DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5433/agent_db
# Demo login. Leave blank to seed no users. Set any value for local testing.
# JWT_SECRET: generate with `openssl rand -hex 32`
DEMO_USERNAME=admin
DEMO_PASSWORD=
JWT_SECRET=